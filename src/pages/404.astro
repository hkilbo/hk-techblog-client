---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import notFound from '@/assets/notFound.png';
---

<BaseLayout title="페이지를 찾을 수 없습니다 | 한국일보 기술 블로그">
  <main id="main" tabindex="-1" class="flex-1 bg-background text-foreground">
    <div class="page-container flex flex-col items-center py-64 text-center md:py-96">
      <Image src={notFound} alt="" widths={[480, 960]} sizes="480px" loading="eager" class="h-auto w-full max-w-480" />
      <h1 class="mt-32 text-28 font-bold">페이지를 찾을 수 없습니다</h1>
      <p class="mt-12 text-17 text-muted">주소가 바뀌었거나 사라진 페이지입니다.</p>
      <a
        href="/"
        class="mt-32 flex h-48 items-center rounded-full bg-brand-lime px-24 text-15 font-semibold text-background transition hover:bg-brand-lime/90 active:scale-98"
      >
        홈으로 가기
      </a>
    </div>
  </main>
</BaseLayout>
