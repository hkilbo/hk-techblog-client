---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HighlightTitle from '@/components/brand/HighlightTitle.astro';
import BackToTop from '@/components/post/BackToTop.astro';
import Giscus from '@/components/post/Giscus.astro';
import PostCard from '@/components/post/PostCard.astro';
import SeriesNav from '@/components/post/SeriesNav.astro';
import { CATEGORY_LABEL, TOPIC_LABEL } from '@/data/categories';
import { getPosts, getRelatedPosts, renderPost, tagSlug } from '@/lib/posts';
import { withBase } from '@/lib/paths';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

// DESIGN.md §8. 본문 열 896px + 목차 224px, lg 미만은 한 열
const { post } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const result = await renderPost(post.id);
if (!result) throw new Error(`글이 없습니다: ${post.id}`); // getStaticPaths가 있는 글만 넘기므로 생기면 빌드 버그다
const { Content, headings, ogImage } = result;
const related = await getRelatedPosts(post);
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
  title={`${post.title} | 한국일보 기술 블로그`}
  description={post.summary}
  image={ogImage}
  type="article"
  publishedAt={post.publishedAt}
>
  <main id="main" tabindex="-1" class="flex-1">
    <article class="page-container py-48 md:py-64">
      <div class="lg:grid lg:grid-cols-[minmax(0,896px)_224px] lg:justify-between lg:gap-40">
        <div class="min-w-0">
          <header>
            <p class="text-12 text-muted">
              <span class="font-bold text-accent">
                {CATEGORY_LABEL[post.category]}
                {post.topic && ` · ${TOPIC_LABEL[post.topic]}`}
              </span>{' '}
              · <time datetime={post.publishedAt}>{post.publishedAt.replaceAll('-', '.')}</time> · {post.readingMinutes}{' '}
              min
            </p>
            <h1 class="mt-16 text-36 font-extrabold tracking-tight text-foreground md:text-48">{post.title}</h1>
            <p class="mt-16 text-17 text-muted">{post.summary}</p>
            {/* 요약과 본문 사이의 저자·태그 상자. 시리즈 상자처럼 surface 면으로 나눈다 */}
            <div class="mt-32 rounded-12 bg-surface p-20">
              <p class="flex items-baseline gap-8 text-14">
                <span class="font-semibold text-foreground">{post.author.name}</span>
                <span class="text-muted">{post.author.role}</span>
              </p>
              {post.tags.length > 0 && (
                <ul class="mt-12 flex flex-wrap gap-8">
                  {post.tags.map((tag) => (
                    <li>
                      <a
                        href={withBase(`/tags/${tagSlug(tag)}/`)}
                        class="block rounded-4 border border-line bg-surface px-8 py-4 text-12 transition-colors hover:border-foreground"
                      >
                        #{tag}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </header>

          <SeriesNav post={post} />
          <div class="post-body mt-40">
            <Content />
          </div>

          <Giscus term={post.id} />
        </div>

        {toc.length > 0 && (
          <aside class="hidden lg:block">
            <nav aria-label="목차" class="sticky top-140">
              <p class="text-14 font-semibold text-foreground">On this page</p>
              <ul class="mt-12 flex flex-col gap-8 border-l border-line pl-16">
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`} class="text-14 text-muted transition-colors hover:text-foreground">
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>

      {related.length > 0 && (
        <section aria-labelledby="related-title" class="mt-80 border-t border-line pt-40">
          <HighlightTitle id="related-title" lead="이 글이 좋았다면," keyword="관련 글" />
          <ul class="mt-24 grid gap-32 md:grid-cols-3">
            {related.map((relatedPost) => (
              <li>
                <PostCard post={relatedPost} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
    <BackToTop />
  </main>
</BaseLayout>
