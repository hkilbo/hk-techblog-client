---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HighlightTitle from '@/components/brand/HighlightTitle.astro';
import SeriesCard from '@/components/series/SeriesCard.astro';
import { getSeriesPosts } from '@/lib/posts';
import { getAllSeries } from '@/lib/series';

// 시리즈 전체를 카드로 보여 준다
const allSeries = await getAllSeries();
const counts = await Promise.all(allSeries.map((series) => getSeriesPosts(series.id).then((posts) => posts.length)));
---

<BaseLayout title="시리즈 | 한국일보 기술 블로그">
  <main id="main" tabindex="-1" class="page-panels flex-1 pb-40 md:pb-64">
    <section class="panel">
      <HighlightTitle as="h1" lead="한 주제를 끝까지 파고든," keyword="시리즈" />
      {allSeries.length > 0 ? (
        <ul class="mt-40 grid gap-32 md:grid-cols-2 lg:grid-cols-3">
          {allSeries.map((series, i) => (
            <li>
              <SeriesCard series={series} count={counts[i]} headingAs="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-40 py-80 text-center text-15 text-muted">
          아직 시리즈가 없어요. 여러 편으로 이어 쓰는 글이 생기면 여기에 모아요.
        </p>
      )}
    </section>
  </main>
</BaseLayout>
