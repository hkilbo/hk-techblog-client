---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ApplyPanel from '@/components/home/ApplyPanel.astro';
import CulturePanel from '@/components/home/CulturePanel.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import ProductPanel from '@/components/home/ProductPanel.astro';
import { getPosts } from '@/lib/posts';

// 한국일보 홈처럼 회색 바탕에 흰 패널을 쌓는다: 히어로(소개 문장·시리즈 + 최신 글 두 편) → Culture·채용 → Product
const posts = await getPosts();
---

<BaseLayout>
  <main id="main" tabindex="-1" class="page-panels flex-1 pb-40 md:pb-64">
    <h1 class="sr-only">한국일보 기술 블로그</h1>
    <HomeHero posts={posts} />
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,2.08fr)_minmax(0,1fr)]">
      <CulturePanel />
      <ApplyPanel />
    </div>
    <ProductPanel />
  </main>
</BaseLayout>
