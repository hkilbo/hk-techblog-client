---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import SeriesSection from '@/components/home/SeriesSection.astro';
import { PostFeed } from '@/components/post/PostFeed';
import { getPosts } from '@/lib/posts';

// 섹션마다 배경이 통째로 바뀐다(커리업 방식): 히어로 검정 → 띠 코랄 → 시리즈·글 목록 흰색
const posts = await getPosts();
---

<BaseLayout>
  <main class="flex-1">
    <Hero />
    <SeriesSection />
    <!-- scroll-mt: 고정된 헤더(76) + GNB(56) 바로 아래에 맞춘다. 글 목록은 화면에 보일 때 붙는다 -->
    <section id="posts" class="page-container scroll-mt-132 py-64 md:py-80">
      <PostFeed client:visible posts={posts} title="All posts" />
    </section>
  </main>
</BaseLayout>
