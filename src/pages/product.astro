---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PostList } from '@/components/post/PostList';
import { SERVICES } from '@/data/services';
import { getPosts } from '@/lib/posts';

// 글 목록이 아니라 서비스 소개 페이지라 Tech처럼 분야 칩을 두지 않는다
const posts = await getPosts('product');
---

<BaseLayout title="Product | 한국일보 기술 블로그">
  <main class="flex-1">
    <section class="bg-background text-foreground">
      <div class="page-container py-64 md:py-96">
        <p class="text-14 font-semibold text-brand-lime">Product</p>
        <h1 class="mt-20 text-36 font-extrabold tracking-tight md:text-48">
          한국일보 개발팀이
          <br />
          만들고 운영하는 서비스
        </h1>
        <p class="mt-20 max-w-520 text-17 text-muted">
          기사를 쓰는 곳부터 독자가 읽는 곳, 대회 사이트까지 직접 만듭니다.
        </p>
      </div>
    </section>

    <section class="page-container py-64 md:py-80">
      <h2 class="text-28 font-bold text-foreground">서비스</h2>
      <ul class="mt-24 grid gap-16 md:grid-cols-2">
        {SERVICES.map(({ icon: Icon, kind, name, description }) => (
          <li class="rounded-12 bg-surface p-24 md:p-32">
            <p class="flex items-center gap-8 text-12 font-extrabold text-muted">
              <Icon class="size-20 text-foreground" stroke-width={1.75} aria-hidden="true" />
              {kind}
            </p>
            <h3 class="mt-16 text-22 font-bold text-foreground">{name}</h3>
            <p class="mt-8 text-15">{description}</p>
          </li>
        ))}
      </ul>

      <h2 class="mt-80 mb-24 text-28 font-bold text-foreground">서비스 이야기</h2>
      <PostList posts={posts} />
    </section>
  </main>
</BaseLayout>
