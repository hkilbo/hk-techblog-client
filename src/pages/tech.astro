---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageTitle from '@/components/brand/PageTitle.astro';
import { PostFeed } from '@/components/post/PostFeed';
import { getPosts } from '@/lib/posts';

const posts = await getPosts('tech');
---

<BaseLayout title="Tech | 한국일보 기술 블로그">
  <main id="main" tabindex="-1" class="page-panels flex-1 pb-40 md:pb-64">
    <!-- 제목은 패널 밖 페이지 바탕에 둔다. 넓은 화면에서는 패널 왼쪽 끝에, 좁은 화면에서는 패널 안 글자와 줄을 맞춘다 -->
    <div class="px-16 pt-16 pb-16 md:px-0 md:pt-24 md:pb-32">
      <PageTitle
        lines={[{ lead: '뉴스를 만드는', keyword: '기술' }]}
        description="한국일보 개발팀이 서비스를 만들고 운영하며 쓴 기술 글을 분야별로 모았습니다."
      />
    </div>
    <section class="panel">
      <PostFeed client:load posts={posts} title="전체 글" />
    </section>
  </main>
</BaseLayout>
