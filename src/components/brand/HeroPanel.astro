---
import type { ComponentProps } from 'astro/types';
import PageTitle from './PageTitle.astro';

// 제목·설명은 PageTitle과 같은 props를 받는다. 이 패널에서는 늘 좁은 칸(narrow)이다
type Props = Omit<ComponentProps<typeof PageTitle>, 'narrow'>;
---

<!-- 홈·Product·Culture의 첫 패널. 왼쪽은 제목·설명, 오른쪽(slot)은 대표 콘텐츠.
     left 슬롯(홈의 시리즈)은 넓은 화면에서 왼쪽 칸 맨 아래에 붙고, 좁은 화면에서는 오른쪽 콘텐츠 아래로 내려간다.
     좁은 화면에서 왼쪽 칸을 contents로 풀어 제목 → 오른쪽 → left 순으로 쌓는다(order) -->
<section class="panel grid grid-cols-1 gap-y-28 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
  <div class="contents lg:flex lg:flex-col lg:justify-between lg:gap-36 lg:pr-36">
    <div class="order-1">
      <PageTitle {...Astro.props} narrow />
    </div>
    {Astro.slots.has('left') && (
      <div class="order-3">
        <slot name="left" />
      </div>
    )}
  </div>
  <div class="order-2 lg:border-l lg:border-line lg:pl-36">
    <slot />
  </div>
</section>
