---
import { InterviewCarousel } from './InterviewCarousel';
import IconicMark from '@/components/brand/IconicMark.astro';
import type { Post } from '@/lib/posts';

interface Props {
  interviews: Post[];
}

// 커리업 일잼원정대 블록을 따라 만든 Culture 첫 화면. 옅은 회색(surface) 바탕에 카드를 올리고, 색은 페이지 테마를 따른다
const { interviews } = Astro.props;
---

<section class="grid-paper bg-surface text-foreground">
  <div class="page-container py-64 md:py-80">
    <!-- 큰 제목은 페이지 심볼 옆에 둔다 -->
    <div class="flex items-center gap-16 md:gap-24">
      <IconicMark variant="culture" />
      <h1 class="min-w-0 text-36 font-extrabold tracking-tight break-keep md:text-48">
        뉴스를 만드는 개발팀은
        <br />
        이렇게 일합니다.
      </h1>
    </div>
    {interviews.length > 0 && (
      <>
        <h2 class="sr-only">개발자 인터뷰</h2>
        <InterviewCarousel client:load posts={interviews} />
      </>
    )}
  </div>
</section>
