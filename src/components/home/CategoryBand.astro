---
import { POST_CATEGORIES } from '@/data/categories';
import { withBase } from '@/lib/paths';

// 404·에러 일러스트의 알약 스티커를 옮겨 왔다. 기울기와 색은 순서대로 돌려 쓴다
const STICKERS = [
  '-rotate-3 bg-background text-brand-lime',
  'rotate-2 bg-foreground text-background',
  '-rotate-2 bg-brand-lime text-background',
];
---

<!-- 히어로와 글 목록 사이의 코랄 띠. 흐르지 않고 멈춰 있으며, 알약은 카테고리 링크다 -->
<nav aria-label="카테고리 바로가기" class="bg-brand-coral">
  <ul class="page-container flex flex-wrap items-center justify-center gap-12 py-32 md:gap-24 md:py-48">
    {POST_CATEGORIES.map(({ value, label }, i) => (
      <li>
        <a
          href={withBase(`/${value}/`)}
          class:list={[
            'flex h-56 items-center rounded-full px-28 text-20 font-extrabold uppercase transition-transform hover:scale-105 hover:rotate-0 motion-reduce:transition-none md:h-72 md:px-40 md:text-28',
            STICKERS[i % STICKERS.length],
          ]}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
