---
interface Props {
  /** 차례로 쓰고 지울 문구. 첫 문구는 처음부터 다 써 둔다. JS 전·움직임 줄이기·스크린리더는 이 문구만 본다 */
  phrases: string[];
}

// 모션 UI M03 타자기(https://motion-ui.altolab.ai/src/typewriter.txt). 깜빡이는 커서는 쓰는 쪽에서 붙인다(animate-blink)
const { phrases } = Astro.props;
---

<span class="sr-only">{phrases[0]}</span>
<span aria-hidden="true" data-typewriter={JSON.stringify(phrases)}>
  {phrases[0]}
</span>

<script>
  const TYPE_MS = 95;
  const HOLD_MS = 1100;
  const DELETE_MS = 45;
  const NEXT_MS = 250;

  // 움직임 줄이기를 켰으면 첫 문구를 그대로 둔다
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-typewriter]').forEach((el) => {
      // 한글은 음절 단위로 끊는다
      const phrases = (JSON.parse(el.dataset.typewriter ?? '[]') as string[]).map((phrase) => [...phrase]);
      if (phrases.length < 2) return;
      let index = 0;
      let length = phrases[0].length; // 첫 문구는 다 써 둔 상태에서 지우기부터 시작한다
      let deleting = false;

      const tick = () => {
        const chars = phrases[index];
        el.textContent = chars.slice(0, length).join('');
        if (!deleting && length < chars.length) {
          length += 1;
          setTimeout(tick, TYPE_MS);
        } else if (!deleting) {
          deleting = true;
          setTimeout(tick, HOLD_MS);
        } else if (length > 0) {
          length -= 1;
          setTimeout(tick, DELETE_MS);
        } else {
          deleting = false;
          index = (index + 1) % phrases.length;
          setTimeout(tick, NEXT_MS);
        }
      };
      tick();
    });
  }
</script>
