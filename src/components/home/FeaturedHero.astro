---
import { ChevronRight, Sparkle } from '@lucide/astro';
import IconicMark from '@/components/brand/IconicMark.astro';
import { CATEGORY_LABEL } from '@/data/categories';
import type { Post } from '@/lib/posts';

interface Props {
  post: Post;
}

// 홈 첫 화면. huick처럼 왼쪽에 아이코닉한 심볼 + 대표 글(가장 최근 글), 오른쪽에 썸네일 + 기울인 스티커
const { post } = Astro.props;
const href = `/posts/${post.id}/`;
---

<section class="page-container grid gap-48 py-48 md:grid-cols-[5fr_7fr] md:items-center md:gap-56 md:py-80">
  <div>
    <IconicMark size="lg" />
    <p class="mt-24 text-12 font-extrabold text-accent uppercase md:text-14">{CATEGORY_LABEL[post.category]}</p>
    <h2 class="mt-8 line-clamp-3 text-28 font-extrabold tracking-tight text-foreground md:text-36">
      <a href={href} class="transition-colors hover:text-accent">
        {post.title}
      </a>
    </h2>
    <p class="mt-16 line-clamp-3 text-15 text-muted">{post.summary}</p>
    <p class="mt-12 text-12 text-muted">
      {post.author.name}
      {' · '}
      <time datetime={post.publishedAt}>{post.publishedAt.replaceAll('-', '.')}</time>
      {' · '}
      {post.readingMinutes} min
    </p>
    <a
      href={href}
      class="mt-32 inline-flex h-40 items-center gap-4 rounded-4 border border-foreground px-16 text-14 font-semibold text-foreground transition-colors hover:bg-foreground hover:text-background"
    >
      바로가기
      <ChevronRight class="size-16" aria-hidden="true" />
    </a>
  </div>

  <div class="relative">
    <a href={href} class="group block overflow-hidden rounded-12" tabindex="-1" aria-hidden="true">
      <img
        src={post.thumbnail}
        alt=""
        fetchpriority="high"
        class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </a>
    <!-- huick의 TOP PICK처럼 기울여 붙인 라임 스티커 -->
    <span class="absolute -top-24 -left-8 flex size-72 -rotate-12 items-center justify-center rounded-full bg-accent text-14 font-extrabold text-background md:-left-16 md:size-88 md:text-16">
      NEW!
    </span>
    <Sparkle
      class="absolute -top-20 -right-8 size-32 text-foreground md:-right-12"
      stroke-width={1.5}
      aria-hidden="true"
    />
    <Sparkle class="absolute -bottom-24 left-1/3 size-20 text-accent" stroke-width={1.5} aria-hidden="true" />
  </div>
</section>
