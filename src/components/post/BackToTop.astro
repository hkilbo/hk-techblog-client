---
import { ArrowUp } from '@lucide/astro';
---

<button
  type="button"
  data-back-to-top
  aria-label="맨 위로"
  class="fixed right-20 bottom-20 z-500 flex size-48 items-center justify-center rounded-full bg-foreground text-background transition active:scale-98 md:right-40 md:bottom-40"
>
  <ArrowUp class="size-20" stroke-width={1.75} aria-hidden="true" />
</button>

<script>
  document.querySelector('[data-back-to-top]')?.addEventListener('click', () =>
    window.scrollTo({
      top: 0,
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
    }),
  );
</script>
