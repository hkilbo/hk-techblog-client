---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import { type Post, getSeriesPosts } from '@/lib/posts';
import { getSeries } from '@/lib/series';

interface Props {
  post: Post;
}

// 시리즈에 속한 글의 머리말 아래 상자. 몇 편인지와 이전·다음 편을 보여 준다
const { post } = Astro.props;
const [series, posts] = post.series
  ? await Promise.all([getSeries(post.series.id), getSeriesPosts(post.series.id)])
  : [undefined, []];
const index = posts.findIndex((p) => p.id === post.id);
const prev = posts[index - 1];
const next = posts[index + 1];
---

{series && (
  <nav aria-label="시리즈" class="mt-32 rounded-12 bg-surface p-20">
    <p class="text-12 font-extrabold text-muted uppercase">
      시리즈 · {index + 1}/{posts.length}편
    </p>
    <a
      href={`/series/${series.id}/`}
      class="mt-4 block text-16 font-semibold text-foreground transition-colors hover:text-accent"
    >
      {series.title}
    </a>
    {(prev || next) && (
      <div class="mt-12 flex flex-col gap-8 text-14 md:flex-row md:justify-between md:gap-16">
        {prev && (
          <a
            href={`/blog/${prev.id}/`}
            class="flex min-w-0 items-center gap-4 text-muted transition-colors hover:text-foreground"
          >
            <ChevronLeft class="size-16 shrink-0" stroke-width={1.75} aria-hidden="true" />
            <span class="truncate">이전 편: {prev.title}</span>
          </a>
        )}
        {next && (
          <a
            href={`/blog/${next.id}/`}
            class="flex min-w-0 items-center gap-4 text-muted transition-colors hover:text-foreground md:ml-auto md:text-right"
          >
            <span class="truncate">다음 편: {next.title}</span>
            <ChevronRight class="size-16 shrink-0" stroke-width={1.75} aria-hidden="true" />
          </a>
        )}
      </div>
    )}
  </nav>
)}
