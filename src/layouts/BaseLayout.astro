---
import '@/styles/global.css';
import Footer from '@/components/layout/Footer.astro';
import Gnb from '@/components/layout/Gnb.astro';
import Header from '@/components/layout/Header.astro';
import { withBase } from '@/lib/paths';
import pretendardUrl from '@/assets/PretendardVariable.woff2?url';

// 카카오톡만 따로 고르는 태그가 없어 og:image 하나를 모든 곳이 같이 쓴다. 카카오는 2:1이 아니면 자동으로 잘라서 카카오용(2:1)을 쓰고,
// 페이스북·링크드인(1.91:1)은 양옆을 38px씩 잘라 보여 준다(글자·그림은 안 잘린다). 일반용으로 바꾸려면 /og.png, 1200×630
const DEFAULT_OG_IMAGE = { src: withBase('/og-kakao.png'), width: 1600, height: 800 };

interface Props {
  title?: string;
  description?: string;
  /** 공유 미리보기 이미지. src는 base를 포함한 사이트 안 경로, 크기는 실제 파일 크기. 없으면 사이트 기본 이미지 */
  image?: { src: string; width: number; height: number };
  /** 글 페이지는 article */
  type?: 'website' | 'article';
  /** article일 때 게시일(YYYY-MM-DD) */
  publishedAt?: string;
}

const {
  title = '한국일보 기술 블로그',
  description = '다양한 관점과 아이디어를 디지털 서비스로 구현하는 한국일보 개발팀의 기술과 개발 이야기를 공유합니다.',
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedAt,
} = Astro.props;
// 공유 미리보기는 절대 주소여야 한다. Astro.url.pathname과 image에는 base가 이미 들어 있다
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- 다크만 쓴다. 헤더·푸터 웹 컴포넌트가 data-theme을 읽어 다크로 그린다 -->
<html lang="ko" data-theme="dark" data-gnb="solid" data-login="off" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- 공유 미리보기(카카오톡·슬랙·X 등) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="한국일보 기술 블로그" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image.src, Astro.site)} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="한국일보 기술 블로그" href={withBase('/rss.xml')} />
    <link rel="preload" href={pretendardUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <!-- 위 여백 = 고정된 헤더(64 / xl 76) + 고정된 GNB(48 / md 56) -->
  <body class="flex min-h-full flex-col pt-112 md:pt-120 xl:pt-132">
    <!-- 키보드 첫 Tab. 헤더·GNB를 건너뛰어 페이지의 <main id="main">으로 간다 -->
    <a
      href="#main"
      class="sr-only rounded-full bg-accent text-14 font-semibold text-background focus:not-sr-only focus:fixed focus:top-12 focus:left-12 focus:z-700 focus:px-16 focus:py-8"
    >
      본문 바로가기
    </a>
    <Header />
    <Gnb />
    <slot />
    <Footer />
  </body>
</html>
